# Supabase project credentials — Dashboard → Project Settings → API
# Copy this file to .env (gitignored) and fill in the values.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Note: only VITE_-prefixed vars reach the browser bundle, and everything that
# reaches the browser is public. Model/API keys belong in Edge Function secrets
# (`supabase secrets set ...`), never here.
